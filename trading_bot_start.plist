<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>trading_bot_start</string>

    <!-- /bin/bash must have Full Disk Access (System Settings > Privacy & Security >
         Full Disk Access) when the project lives in ~/Documents. Without FDA the
         shell gets EPERM reading the script and launchd loops on the failure. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>PLACEHOLDER_PROJECT_DIR/start.sh</string>
        <string>--foreground</string>
    </array>

    <key>WorkingDirectory</key>
    <string>PLACEHOLDER_PROJECT_DIR</string>

    <!-- Fire Mon-Fri at 05:30 PT (= 08:30 ET, before 08:45 ET volatility screener).
         PT is always ET-3 regardless of DST — no timezone confusion.
         If the laptop is asleep at 05:30, launchd fires on next wake. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>5</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>5</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>5</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>5</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>5</integer><key>Minute</key><integer>30</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>PLACEHOLDER_PROJECT_DIR/logs/launchd_trading_bot.log</string>
    <key>StandardErrorPath</key>
    <string>PLACEHOLDER_PROJECT_DIR/logs/launchd_trading_bot.log</string>

    <!-- Do NOT use KeepAlive here. If bash is blocked by TCC (no FDA) launchd
         would restart every ThrottleInterval seconds, flooding the log. The bot's
         own crash-loop guard (main.py) handles intra-session recovery; launchd's
         StartCalendarInterval handles the next-day restart. -->
    <key>KeepAlive</key>
    <false/>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
