<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>trading_bot_stop</string>

    <!-- /bin/bash must have Full Disk Access when the project lives in ~/Documents.
         See setup_launchagent.sh output for instructions. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>PLACEHOLDER_PROJECT_DIR/stop.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>PLACEHOLDER_PROJECT_DIR</string>

    <!-- Fire Mon-Fri at 13:30 PT (= 16:30 ET, after 16:15 ET learning agent).
         PT is always ET-3 regardless of DST — no timezone confusion.
         If the laptop is asleep at 13:30, launchd fires on next wake. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>30</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>PLACEHOLDER_PROJECT_DIR/logs/launchd_trading_bot.log</string>
    <key>StandardErrorPath</key>
    <string>PLACEHOLDER_PROJECT_DIR/logs/launchd_trading_bot.log</string>

    <key>KeepAlive</key>
    <false/>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
