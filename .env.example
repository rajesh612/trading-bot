# Copy this file to .env and fill in your credentials.
# Never commit .env to git.

# ── Alpaca (paper trading by default) ─────────────────────────────────────────
# Get these from https://app.alpaca.markets → API Keys
# Use PAPER keys to start. When you switch to a live account, regenerate
# from the Live tab and replace these values; no other config change needed.
# Stocks are commission-free on both paper and live (regulatory fees apply on
# sells: ~$0.01–$0.05 per typical trade — SEC + TAF only, no Alpaca commission).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Get from https://console.anthropic.com → API Keys
# Bot enforces a $1.00/$1.50 daily ceiling via api_budget.py.
ANTHROPIC_API_KEY=

# ── FRED (Federal Reserve Economic Data) — free ──────────────────────────────
# Get from https://fred.stlouisfed.org/docs/api/api_key.html (free, instant)
# Used for Fed funds rate, CPI, unemployment trends in macro_regime.py.
# Leave blank to skip — bot defaults to neutral fred_modifier (0).
FRED_API_KEY=

# ── Market data provider ──────────────────────────────────────────────────────
# Selects where the bot fetches intraday + daily bars.
#   yahoo   — Yahoo Finance (default; free, no auth, full volume)
#   alpaca  — Alpaca data API (paper = IEX-only ~2% volume; live = full SIP)
#   hybrid  — Yahoo for bars, Alpaca for real-time quotes (recommended on paper)
# When you upgrade to a live Alpaca account with Algo Trader Plus subscription
# ($99/mo for SIP real-time data), switch to MARKET_DATA_PROVIDER=alpaca.
MARKET_DATA_PROVIDER=yahoo

# ── Polygon / Massive (optional) ──────────────────────────────────────────────
# Optional: cross-checks SPY flash-crash readings via Massive API (ex-Polygon.io).
# Get free key at https://massive.com/dashboard/keys
POLYGON_API_KEY=

# ── Reddit (optional) ─────────────────────────────────────────────────────────
# Register an app at https://www.reddit.com/prefs/apps (script type)
# Leave blank to skip Reddit sentiment — bot degrades gracefully.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=TradingBot/1.0

# ── X / Twitter (optional, $100/mo Basic API) ─────────────────────────────────
# Get from https://developer.twitter.com
# Leave blank to skip X sentiment — bot degrades gracefully.
X_BEARER_TOKEN=

# ── Daily email report ─────────────────────────────────────────────────────────
# Gmail App Password — NOT your real password.
# Generate: myaccount.google.com → Security → 2-Step Verification → App Passwords
# Leave blank to disable the daily report entirely.
EMAIL_SENDER=
EMAIL_APP_PASSWORD=
EMAIL_RECIPIENT=
TELEGRAM_BOT_TOKEN=<token from BotFather>                                                                                                                    
TELEGRAM_CHAT_ID=<chat id from getUpdates>
