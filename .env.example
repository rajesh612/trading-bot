# Copy this file to .env and fill in your credentials.
# Never commit .env to git.

# ── Alpaca (paper trading) ────────────────────────────────────────────────────
# Get these from https://app.alpaca.markets → API Keys
# Use PAPER keys only — live keys are not tested and could cause real losses.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Get from https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ── Reddit (optional) ─────────────────────────────────────────────────────────
# Register an app at https://www.reddit.com/prefs/apps (script type)
# Leave blank to skip Reddit sentiment — bot degrades gracefully.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=TradingBot/1.0

# ── X / Twitter (optional, $100/mo Basic API) ─────────────────────────────────
# Get from https://developer.twitter.com
# Leave blank to skip X sentiment — bot degrades gracefully.
X_BEARER_TOKEN=

# ── Daily email report ─────────────────────────────────────────────────────────
# Gmail App Password — NOT your real password.
# Generate: myaccount.google.com → Security → 2-Step Verification → App Passwords
# Leave blank to disable the daily report entirely.
EMAIL_SENDER=
EMAIL_APP_PASSWORD=
EMAIL_RECIPIENT=
